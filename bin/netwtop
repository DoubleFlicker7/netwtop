#!/bin/sh
# Main netwtop entry point. Functional code lives in the module tree.

set -u
umask 077

BIN_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1
PREFIX_DIR=$(CDPATH= cd -- "$BIN_DIR/.." && pwd) || exit 1

if [ -n "${NETWTOP_MODULE_ROOT:-}" ]; then
    :
elif [ -n "${NETWTOP_LIB_DIR:-}" ]; then
    # Backward-compatible override used by earlier development integrations.
    NETWTOP_MODULE_ROOT=$NETWTOP_LIB_DIR
elif [ -r "$PREFIX_DIR/src/manifest.sh" ]; then
    NETWTOP_MODULE_ROOT=$PREFIX_DIR/src
else
    NETWTOP_MODULE_ROOT=$PREFIX_DIR/lib/netwtop
fi

if [ ! -r "$NETWTOP_MODULE_ROOT/manifest.sh" ]; then
    printf 'Error: Required netwtop module manifest not found: %s\n' \
        "$NETWTOP_MODULE_ROOT/manifest.sh" >&2
    exit 1
fi
. "$NETWTOP_MODULE_ROOT/manifest.sh"

for module in $NETWTOP_RUNTIME_MODULES $NETWTOP_RESOURCE_FILES; do
    if [ ! -r "$NETWTOP_MODULE_ROOT/$module" ]; then
        printf 'Error: Required netwtop module not found: %s\n' \
            "$NETWTOP_MODULE_ROOT/$module" >&2
        exit 1
    fi
done

for module in $NETWTOP_RUNTIME_MODULES; do
    . "$NETWTOP_MODULE_ROOT/$module"
done

PROGRAM=${NETWTOP_PROGRAM_NAME:-${0##*/}}
INTERVAL=0.5
INTERVAL_TENTHS=5
COUNT=
DISPLAY_MODE=auto
TWO_COLUMN_WIDTH=100
FORMAT=table
OUTPUT=
APPEND=0
DEVICE=
INTERFACE_NAMES=
INTERFACE_COUNT=0
INTERFACE_INDEX=0
INTERFACE_SWITCH_PENDING=0
INTERFACE_SWITCH_DIRECTION=0
STOPPING=0
WORK_DIR=
TABLE_TARGET=
INTERACTIVE_TABLE=0
TTY_STATE=
ALT_SCREEN=0
CURSOR_HIDDEN=0
MOUSE_ENABLED=0
RESIZE_PENDING=0
LAST_UI_WIDTH=0
LAST_UI_HEIGHT=0
TABLE_SCROLL=0
TABLE_PAGE_SIZE=1
COMMAND_SCROLL_UID=
COMMAND_SCROLL_OFFSET=0
SELECTED_UID=
SELECTED_PID=
EXPANDED_UID=
COMMAND_VIEW_SIZE=2
ESCAPE_SEQUENCE=$(printf '\033')
MACOS_NETTOP=
MACOS_NETSTAT=
MACOS_ROUTE=
MACOS_IFCONFIG=
INTERFACE_RX_DELTA=0
INTERFACE_TX_DELTA=0
ELAPSED_TICKS=100
ATTRIBUTION_DEVICE_SCOPED=0
HISTORY_SAMPLE=0
HISTORY_LIMIT=120
LOGIN_UID_MIN=1000
CURRENT_UID=
CURRENT_USER=
INVOKING_UID=
SHOW_ALL_COMMANDS=0

parse_options "$@"
validate_options
validate_commands
detect_platform
configure_user_scope
configure_interface
configure_table_target
create_workspace

trap cleanup 0
trap request_stop HUP INT TERM
trap request_resize WINCH

enable_interactive_terminal
: >"$TOTALS"
: >"$COMMAND_TOTALS"
: >"$HISTORY"
prepare_output

snapshot_interface "$INTERFACE_PREVIOUS"
take_snapshot "$PREVIOUS"
REPORTS=0

while [ "$STOPPING" -eq 0 ]; do
    wait_interval_or_key
    [ "$STOPPING" -eq 0 ] || break

    if [ "$INTERFACE_SWITCH_PENDING" -eq 1 ]; then
        switch_direction=$INTERFACE_SWITCH_DIRECTION
        INTERFACE_SWITCH_PENDING=0
        INTERFACE_SWITCH_DIRECTION=0
        if switch_interface "$switch_direction"; then
            # Both collectors need a fresh baseline. Reusing the previous
            # interface counters would create a false spike; reusing the
            # previous process snapshot would inflate all-interface user rates
            # across the extra wait interval.
            snapshot_interface "$INTERFACE_PREVIOUS"
            take_snapshot "$PREVIOUS"
            reset_interface_history
            INTERFACE_RX_DELTA=0
            INTERFACE_TX_DELTA=0
            continue
        fi
    fi

    snapshot_interface "$INTERFACE_CURRENT"
    take_snapshot "$CURRENT"
    calculate_interface_delta

    build_uid_names
    calculate_rows "$ELAPSED"
    sync_highlight_visibility
    record_history "$ELAPSED"
    ACTIVE_ENTRIES=$(LC_ALL=C awk -F '\t' \
        '{ total += $6 } END { print total + 0 }' "$ROWS")
    TIMESTAMP=$(date '+%Y-%m-%dT%H:%M:%S%z')

    case $FORMAT in
        table) report_table "$TIMESTAMP" "$ELAPSED" "$ACTIVE_ENTRIES" ;;
        csv) report_csv "$TIMESTAMP" "$ELAPSED" "$ACTIVE_ENTRIES" ;;
        jsonl) report_jsonl "$TIMESTAMP" "$ELAPSED" "$ACTIVE_ENTRIES" ;;
    esac

    mv "$CURRENT" "$PREVIOUS"
    mv "$INTERFACE_CURRENT" "$INTERFACE_PREVIOUS"
    REPORTS=$((REPORTS + 1))
    if [ -n "$COUNT" ] && [ "$REPORTS" -ge "$COUNT" ]; then
        break
    fi
done

exit 0
