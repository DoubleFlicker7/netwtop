#!/bin/sh

set -eu

netwtop --help | grep -q 'Usage: netwtop'
test "$(netwtop --version)" = 'netwtop 0.1.1'
test -x /usr/bin/netwtop
test -r /usr/lib/netwtop/manifest.sh
test -r /usr/lib/netwtop/ui/table.awk

for installed_module in \
    /usr/lib/netwtop/runtime/runtime.sh \
    /usr/lib/netwtop/backends/common.sh \
    /usr/lib/netwtop/backends/linux.sh \
    /usr/lib/netwtop/backends/macos.sh \
    /usr/lib/netwtop/core/interfaces.sh \
    /usr/lib/netwtop/core/accounting.sh \
    /usr/lib/netwtop/core/history.sh \
    /usr/lib/netwtop/output/formats.sh \
    /usr/lib/netwtop/ui/table.sh
do
    test -r "$installed_module"
    sh -n "$installed_module"
done

smoke_output=$(mktemp "${TMPDIR:-/tmp}/netwtop-autopkgtest.XXXXXX")
trap 'rm -f "$smoke_output"' EXIT HUP INT TERM
netwtop --interval 0.1 --format jsonl --count 1 >"$smoke_output"
grep -q '"backend":"Linux sysfs + ss"' "$smoke_output"
